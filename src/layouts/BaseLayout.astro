---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { SITE } from '../data/site';
import { BRAND_IMAGES } from '../data/content';
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
  preloadHero?: boolean;
}

const {
  locale,
  title,
  description,
  noindex = false,
  preloadHero = false,
} = Astro.props;

const t = getTranslations(locale);
const pageTitle = title ?? t.seo.title;
const pageDescription = description ?? t.seo.description;
const canonicalPath = locale === 'en' ? '/en' : '/';
const canonicalUrl = `${SITE.url}${canonicalPath}`;
const ogImageUrl = `${SITE.url}${SITE.ogImage}`;

const preloadedHero = preloadHero
  ? await getImage({
      src: BRAND_IMAGES.heroCover,
      widths: [640, 960, 1334],
      format: 'webp',
      quality: 82,
    })
  : null;

const sameAs: string[] = [SITE.social.facebook];
if (SITE.social.instagram !== 'https://www.instagram.com') {
  sameAs.push(SITE.social.instagram);
}

const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t.seo.organizationName,
  alternateName: t.seo.organizationAltName,
  url: SITE.url,
  logo: `${SITE.url}/favicon.png`,
  description: t.seo.description,
  email: SITE.email,
  telephone: SITE.phoneSchema,
  sameAs,
  founder: {
    '@type': 'Person',
    name: t.seo.founderName,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: SITE.email,
    telephone: SITE.phoneSchema,
    availableLanguage: ['zh-TW', 'en'],
  },
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0a0a0c" />

    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />

    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <link rel="alternate" hreflang="zh-TW" href={`${SITE.url}/`} />
          <link rel="alternate" hreflang="en" href={`${SITE.url}/en`} />
          <link rel="alternate" hreflang="x-default" href={`${SITE.url}/`} />
        </>
      )
    }

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t.seo.ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={t.seo.ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={t.ogAlternateLocale} />
    <meta property="og:site_name" content={t.seo.organizationName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={t.seo.ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t.seo.ogImageAlt} />

    {
      preloadedHero && (
        <link
          rel="preload"
          as="image"
          href={preloadedHero.src}
          imagesrcset={preloadedHero.srcSet.attribute}
          imagesizes="100vw"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    <script is:inline type="application/ld+json" set:html={organizationJsonLd} />
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link visually-hidden" href="#main-content">
      {t.skipToContent}
    </a>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
