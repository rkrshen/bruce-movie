---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { SITE } from '../data/site';
import { BRAND_IMAGES, HERO_IMAGE_CONFIG } from '../data/content';
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
  preloadHero?: boolean;
}

const {
  locale,
  title,
  description,
  noindex = false,
  preloadHero = false,
} = Astro.props;

const t = getTranslations(locale);
const pageTitle = title ?? t.seo.title;
const pageDescription = description ?? t.seo.description;
const socialDescription = description ?? t.seo.ogDescription;
const canonicalPath = locale === 'en' ? '/en' : '/';
const canonicalUrl = `${SITE.url}${canonicalPath}`;
const ogImageUrl = `${SITE.url}${SITE.ogImage}`;
const logoUrl = `${SITE.url}${SITE.logo}`;

const preloadedHero = preloadHero
  ? await getImage({
      src: BRAND_IMAGES.heroCover,
      widths: HERO_IMAGE_CONFIG.widths,
      format: HERO_IMAGE_CONFIG.format,
      quality: HERO_IMAGE_CONFIG.quality,
    })
  : null;

const sameAs: string[] = [SITE.social.facebook];
if (SITE.social.instagram !== 'https://www.instagram.com') {
  sameAs.push(SITE.social.instagram);
}

const structuredDataJsonLd = !noindex
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${SITE.url}/#website`,
          url: `${SITE.url}/`,
          name: t.seo.organizationName,
          alternateName: [t.seo.organizationAltName, SITE.legalName, 'brucemovie.com'],
          inLanguage: ['zh-TW', 'en'],
          publisher: {
            '@id': `${SITE.url}/#organization`,
          },
        },
        {
          '@type': 'Organization',
          '@id': `${SITE.url}/#organization`,
          name: t.seo.organizationName,
          legalName: SITE.legalName,
          alternateName: t.seo.organizationAltName,
          url: `${SITE.url}/`,
          logo: {
            '@type': 'ImageObject',
            '@id': `${SITE.url}/#logo`,
            url: logoUrl,
            contentUrl: logoUrl,
            width: SITE.logoWidth,
            height: SITE.logoHeight,
            caption: t.seo.organizationName,
          },
          image: {
            '@id': `${SITE.url}/#primaryimage`,
          },
          description: t.seo.description,
          email: SITE.email,
          telephone: SITE.phoneSchema,
          areaServed: {
            '@type': 'Country',
            name: t.seo.areaServed,
          },
          knowsAbout: t.seo.knowsAbout,
          award: t.seo.awards,
          sameAs,
          founder: {
            '@id': `${SITE.url}/#founder`,
          },
          contactPoint: {
            '@type': 'ContactPoint',
            contactType: 'customer support',
            email: SITE.email,
            telephone: SITE.phoneSchema,
            areaServed: 'TW',
            availableLanguage: ['zh-TW', 'en'],
          },
        },
        {
          '@type': 'Person',
          '@id': `${SITE.url}/#founder`,
          name: t.seo.founderName,
          alternateName: t.seo.founderAltName,
          jobTitle: t.seo.founderJobTitle,
          award: t.seo.awards,
        },
        {
          '@type': 'WebPage',
          '@id': `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: pageTitle,
          description: pageDescription,
          inLanguage: t.lang,
          isPartOf: {
            '@id': `${SITE.url}/#website`,
          },
          about: {
            '@id': `${SITE.url}/#organization`,
          },
          primaryImageOfPage: {
            '@type': 'ImageObject',
            '@id': `${SITE.url}/#primaryimage`,
            url: ogImageUrl,
            contentUrl: ogImageUrl,
            width: SITE.ogImageWidth,
            height: SITE.ogImageHeight,
            caption: t.seo.ogImageAlt,
          },
        },
      ],
    }).replace(/</g, '\\u003c')
  : null;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#0a0a0c" />

    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />

    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <link rel="alternate" hreflang="zh-TW" href={`${SITE.url}/`} />
          <link rel="alternate" hreflang="en" href={`${SITE.url}/en`} />
          <link rel="alternate" hreflang="x-default" href={`${SITE.url}/`} />
        </>
      )
    }

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={t.seo.ogImageAlt} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={t.ogAlternateLocale} />
    <meta property="og:site_name" content={t.seo.organizationName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t.seo.ogImageAlt} />

    {
      preloadedHero && (
        <link
          rel="preload"
          as="image"
          href={preloadedHero.src}
          imagesrcset={preloadedHero.srcSet.attribute}
          imagesizes={HERO_IMAGE_CONFIG.sizes}
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    {
      structuredDataJsonLd && (
        <script is:inline type="application/ld+json" set:html={structuredDataJsonLd} />
      )
    }
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link visually-hidden" href="#main-content">
      {t.skipToContent}
    </a>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
