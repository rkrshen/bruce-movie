---
import { getTranslations, type Locale } from '../i18n';
import Icons from './Icons.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<section class="section section-contact-us text-center" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <h2 class="title" id="contact-heading">{t.contact.title}</h2>
    <p class="description">{t.contact.description}</p>

    <form
      class="contact-form"
      id="contact-form"
      novalidate
      data-locale={locale}
      data-turnstile-enabled={turnstileSiteKey ? 'true' : 'false'}
      data-msg-name={t.contact.validation.name}
      data-msg-email-required={t.contact.validation.emailRequired}
      data-msg-email-invalid={t.contact.validation.emailInvalid}
      data-msg-message={t.contact.validation.message}
      data-msg-validation={t.contact.status.validation}
      data-msg-turnstile={t.contact.status.turnstileRequired}
      data-msg-success={t.contact.status.success}
      data-msg-error={t.contact.status.error}
      data-label-submit={t.contact.submit}
      data-label-sending={t.contact.sending}
    >
      <input
        type="checkbox"
        name="botcheck"
        class="botcheck-field"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="contact-field">
        <label class="visually-hidden" for="contact-name">{t.contact.nameLabel}</label>
        <div class="contact-input-pill" id="contact-name-wrap">
          <span class="contact-input-icon" aria-hidden="true">
            <Icons name="user" size={18} />
          </span>
          <input
            id="contact-name"
            name="name"
            type="text"
            class="contact-input"
            autocomplete="name"
            maxlength="100"
            required
            placeholder={t.contact.namePlaceholder}
            aria-describedby="contact-name-error"
          />
        </div>
        <p class="contact-field-error" id="contact-name-error" hidden></p>
      </div>

      <div class="contact-field">
        <label class="visually-hidden" for="contact-email">{t.contact.emailLabel}</label>
        <div class="contact-input-pill" id="contact-email-wrap">
          <span class="contact-input-icon" aria-hidden="true">
            <Icons name="mail" size={18} />
          </span>
          <input
            id="contact-email"
            name="email"
            type="email"
            class="contact-input"
            autocomplete="email"
            maxlength="254"
            required
            placeholder={t.contact.emailPlaceholder}
            aria-describedby="contact-email-error"
          />
        </div>
        <p class="contact-field-error" id="contact-email-error" hidden></p>
      </div>

      <div class="contact-field">
        <label class="visually-hidden" for="contact-message">{t.contact.messageLabel}</label>
        <textarea
          id="contact-message"
          name="message"
          class="contact-textarea"
          rows="4"
          maxlength="3000"
          required
          placeholder={t.contact.messagePlaceholder}
          aria-describedby="contact-message-error"
        ></textarea>
        <p class="contact-field-error" id="contact-message-error" hidden></p>
      </div>

      {
        turnstileSiteKey && (
          <div class="turnstile-wrapper" aria-label={t.contact.turnstileLabel}>
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="dark"
              data-language={locale === 'en' ? 'en' : 'zh-tw'}
            />
          </div>
        )
      }

      <p
        class="contact-status"
        id="contact-status"
        role="status"
        aria-live="polite"
      ></p>

      <button type="submit" class="btn-primary" id="contact-submit">
        {t.contact.submit}
      </button>
    </form>
  </div>
</section>

{
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}
