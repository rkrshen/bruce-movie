---
import { Image } from 'astro:assets';
import { BRAND_IMAGES } from '../data/content';
import { getTranslations, type Locale } from '../i18n';
import Icons from './Icons.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <div class="hero__backdrop" data-parallax>
    <Image
      src={BRAND_IMAGES.heroCover}
      alt={t.media.heroAlt}
      widths={[640, 960, 1334]}
      sizes="100vw"
      format="webp"
      quality={84}
      fetchpriority="high"
      loading="eager"
      decoding="sync"
      class="hero__media"
    />
  </div>

  <div class="hero__scrim" aria-hidden="true"></div>
  <canvas class="hero__embers" id="hero-embers" aria-hidden="true"></canvas>

  <div class="hero__frame" aria-hidden="true">
    <span class="hero__corner hero__corner--tl"></span>
    <span class="hero__corner hero__corner--tr"></span>
    <span class="hero__corner hero__corner--bl"></span>
    <span class="hero__corner hero__corner--br"></span>
  </div>

  <div class="container hero__content">
    <div class="hero__lockup">
      <div class="hero__kicker" aria-hidden="true">
        <span class="hero__kicker-dot"></span>
        <span>PRACTICAL VFX · PYROTECHNICS · TAIWAN</span>
      </div>
      <h1 class="hero__title" id="hero-heading">{t.mainTitle.title}</h1>
      <p class="hero__subtitle">{t.mainTitle.subTitle}</p>
    </div>

    <a class="hero__scroll-cue" href="#about">
      <span>{t.mainTitle.scrollCue}</span>
      <span class="hero__scroll-icon" aria-hidden="true">
        <Icons name="arrow-down" size={16} />
      </span>
    </a>
  </div>
</section>
