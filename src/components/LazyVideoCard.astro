---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description?: string;
  poster: ImageMetadata;
  src: string;
  playLabel: string;
  playAriaLabel: string;
  unsupportedText: string;
  centered?: boolean;
}

const {
  title,
  description,
  poster,
  src,
  playLabel,
  playAriaLabel,
  unsupportedText,
  centered = false,
} = Astro.props;
---

<article class:list={['lazy-video-card', centered && 'lazy-video-card--centered']}>
  <h3 class="lazy-video-card__title">{title}</h3>
  <div
    class="video-stage video-stage--tall"
    data-lazy-video
    data-video-src={src}
    data-video-unsupported={unsupportedText}
  >
    <button
      type="button"
      class="lazy-video-card__preview"
      aria-label={playAriaLabel}
    >
      <Image
        src={poster}
        alt={title}
        widths={[480, 640, 960]}
        sizes="(min-width: 768px) 45vw, 100vw"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
        class="lazy-video-card__poster"
      />
      <span class="lazy-video-card__overlay" aria-hidden="true">
        <span class="lazy-video-card__play">{playLabel}</span>
      </span>
    </button>
  </div>
  {description && <p class="lazy-video-card__description">{description}</p>}
</article>
