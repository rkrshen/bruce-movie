---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icons from './Icons.astro';

interface Props {
  title: string;
  description?: string;
  poster: ImageMetadata;
  src: string;
  playLabel: string;
  playAriaLabel: string;
  unsupportedText: string;
  centered?: boolean;
}

const {
  title,
  description,
  poster,
  src,
  playLabel,
  playAriaLabel,
  unsupportedText,
  centered = false,
} = Astro.props;
---

<article
  class:list={['reel-card', centered && 'reel-card--centered']}
  data-reveal
  data-spotlight
>
  <div
    class="video-stage"
    data-lazy-video
    data-video-src={src}
    data-video-unsupported={unsupportedText}
  >
    <button
      type="button"
      class="lazy-video-card__preview"
      aria-label={playAriaLabel}
    >
      <Image
        src={poster}
        alt={title}
        widths={[480, 640, 960]}
        sizes="(min-width: 768px) 46vw, 100vw"
        format="webp"
        quality={82}
        loading="lazy"
        decoding="async"
        class="lazy-video-card__poster"
      />
      <span class="lazy-video-card__overlay" aria-hidden="true">
        <span class="video-play-orb">
          <Icons name="play" size={20} />
        </span>
        <span class="lazy-video-card__play">{playLabel}</span>
      </span>
    </button>
  </div>

  <div class="reel-card__meta">
    <h3 class="reel-card__title">{title}</h3>
    {description && <p class="reel-card__description">{description}</p>}
  </div>
</article>
