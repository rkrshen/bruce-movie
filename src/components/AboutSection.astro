---
import { Image } from 'astro:assets';
import { BRAND_IMAGES } from '../data/content';
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const pillars = [
  { num: '01', heading: t.intro.team, body: t.intro.paragraph2 },
  { num: '02', heading: t.intro.legitimate, body: t.intro.paragraph3 },
  { num: '03', heading: t.intro.founder, body: t.intro.paragraph1 },
];
---

<section class="section section-about" id="about" tabindex="-1" aria-labelledby="about-heading">
  <div class="container">
    <header class="section-header section-header--wide" data-reveal>
      <p class="section-eyebrow" aria-hidden="true">
        <span class="section-eyebrow__num">01</span>
        <span class="section-eyebrow__line"></span>
        <span>{t.header.intro}</span>
      </p>
      <h2 class="section-title section-title--hero" id="about-heading">{t.about.title}</h2>
      <p class="section-lead">{t.about.description}</p>
    </header>

    <div class="about-bento">
      <div class="about-visual-col">
        <figure class="media-card media-card--founder" data-reveal>
          <Image
            src={BRAND_IMAGES.founderImg}
            alt={t.media.founderAlt}
            widths={[480, 586]}
            sizes="(min-width: 992px) 46vw, 100vw"
            format="webp"
            quality={84}
            loading="lazy"
            decoding="async"
            class="media-card__img"
          />
        </figure>

        <blockquote class="manifesto-quote" data-reveal data-spotlight>
          <span class="manifesto-quote__mark" aria-hidden="true">“</span>
          <div class="manifesto-quote__lines">
            <p>{t.story.line1}</p>
            <p>{t.story.line2}</p>
            <p>{t.story.line3}</p>
          </div>
          <footer class="manifesto-quote__author">{t.story.founder}</footer>
        </blockquote>

        <div class="about-secondary-media">
          <figure class="media-card media-card--award" data-reveal>
            <Image
              src={BRAND_IMAGES.awardMainImg}
              alt={t.media.awardAlt}
              widths={[480, 716]}
              sizes="(min-width: 992px) 46vw, 100vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
              class="media-card__img"
            />
          </figure>

          <figure class="media-card media-card--bts" data-reveal>
            <Image
              src={BRAND_IMAGES.behindScenesImg}
              alt={t.media.behindScenesAlt}
              widths={[480, 602]}
              sizes="(min-width: 992px) 46vw, 100vw"
              format="webp"
              quality={84}
              loading="lazy"
              decoding="async"
              class="media-card__img"
            />
          </figure>
        </div>
      </div>

      <div class="about-pillars-col">
        {
          pillars.map((pillar) => (
            <article class="pillar-card" data-reveal data-spotlight>
              <span class="pillar-card__num" aria-hidden="true">{pillar.num}</span>
              <h3 class="pillar-card__title">{pillar.heading}</h3>
              <p class="pillar-card__body">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
