# Frontend public variable (set in Cloudflare Pages > Settings > Environment Variables)
# Optional: Cloudflare Turnstile Site Key for contact form bot protection
PUBLIC_TURNSTILE_SITE_KEY=

# Server-side secrets (set as ENCRYPTED Secrets in Cloudflare Pages > Environment Variables)
# Never prefix these with PUBLIC_
WEB3FORMS_ACCESS_KEY=
TURNSTILE_SECRET_KEY=
