# ==============================================================================
# Default mode (works out of the box on GitHub Pages, Cloudflare Pages & local):
# Direct browser submission to Web3Forms API.
# Note: Web3Forms Free plan blocks server-side/Worker POSTs (HTTP 403); its
# access_key is intentionally a public form ID.
# ==============================================================================
# Optional override for Web3Forms public access key (defaults to src/data/site.ts)
PUBLIC_WEB3FORMS_ACCESS_KEY=

# ==============================================================================
# Optional server-side mode (Cloudflare Pages Functions + Resend + Turnstile):
# Set PUBLIC_CONTACT_ENDPOINT=/api/contact to switch from Web3Forms to
# functions/api/contact.ts using Resend API.
# ==============================================================================
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_TURNSTILE_SITE_KEY=

# Server-side secrets (set as ENCRYPTED Secrets in Cloudflare Pages, NEVER PUBLIC_)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=brucemovie@gmail.com
TURNSTILE_SECRET_KEY=
